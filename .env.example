# Postgres connection string (Neon, Supabase, Vercel Postgres or local)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/abss_online

# Long random string used to sign auth tokens — generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Public URL of the site (no trailing slash). Used for absolute links, sitemap and OG images.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Media storage. Leave unset locally and uploads are saved to the /media folder.
# In production all five are required: a private S3 bucket, an IAM user that may read and
# write it, and the CloudFront address that serves it (no trailing slash).
# S3_BUCKET=
# S3_REGION=eu-west-2
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# MEDIA_CDN_URL=https://dxxxxxxxxxxxx.cloudfront.net

# Contact form (required in production). CONTACT_EMAIL is the school inbox that is told about
# each enquiry. RESEND_API_KEY sends that email; without it the email is printed to the
# console. EMAIL_FROM must be on a domain verified in Resend.
# CONTACT_EMAIL=
# RESEND_API_KEY=
# EMAIL_FROM=noreply@theabss.org

# Optional — Cloudflare Turnstile human check on the contact form. Set both or neither.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Required in production — Vercel Cron sends it as a Bearer token to
# /api/cron/purge-enquiries, which deletes old enquiries. Generate with: openssl rand -hex 32
# CRON_SECRET=

# Optional — secret for the on-demand revalidation endpoint (POST /api/revalidate)
# REVALIDATION_SECRET=

# Optional. Integration tests use their own database so they never touch the one the dev
# server shows. Defaults to DATABASE_URL with "_test" added to the name (created if missing).
# TEST_DATABASE_URL=

# Optional. Extra https sites allowed to show the public pages in a frame, such as a portfolio's
# live-demo window (space separated). /admin and /api are never framable. Read at build time,
# so redeploy after changing it.
# FRAME_ANCESTORS=
